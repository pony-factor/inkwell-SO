# Local-only development (no GitHub sign-in; never expose this mode publicly)
LOCAL_DEV_MODE=1
HOST=127.0.0.1
PORT=3000
APP_BASE_URL=http://127.0.0.1:3000

# Model provider: add a key to enable actual spellchecking
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Production GitHub App user OAuth (remove LOCAL_DEV_MODE, use HTTPS)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=

# GitHub webhook integration (configured in the next implementation stage)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# File persistence; use durable storage in deployments
DATA_FILE=./data/users.json
