# Local-only interface: never use this mode with HOST=0.0.0.0
LOCAL_DEV_MODE=1
HOST=127.0.0.1
PORT=3000
APP_BASE_URL=http://127.0.0.1:3000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Production: disable LOCAL_DEV_MODE and use an HTTPS APP_BASE_URL
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=

# GitHub App webhook and installation credentials
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
# Alternate: GITHUB_PRIVATE_KEY with literal backslash-n PEM separators
GITHUB_WEBHOOK_SECRET=

DATA_FILE=./data/users.json
